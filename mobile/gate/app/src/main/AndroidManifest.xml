<uses-feature android:name="android.hardware.camera.any" android:required="true"/>
<application android:allowBackup="false" android:usesCleartextTraffic="false" android:label="@string/app_name" android:icon="@drawable/gate_icon" android:theme="@android:style/Theme.Material.Light.NoActionBar">
